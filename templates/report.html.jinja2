<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Buy in the UK? — Board Games Advisor</title>
<style>
  :root {
    --bg: #f7f7f5;
    --panel: #ffffff;
    --border: #e2e0da;
    --text: #24211c;
    --text-dim: #6b6559;
    --link: #1a5276;
    --unavailable: #2e7d32;
    --outofstock: #b8860b;
    --cheaper: #1565c0;
    --flag-bg: #fdecea;
    --flag-text: #b71c1c;
    --favorite: #c2185b;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 2rem 1.5rem 4rem;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  h1 { margin: 0 0 0.25rem; font-size: 1.6rem; }
  .subtitle { color: var(--text-dim); margin: 0 0 1.25rem; font-size: 0.95rem; }
  .meta { color: var(--text-dim); font-size: 0.85rem; margin-bottom: 1.5rem; }
  .controls {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .filter-input {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 1rem;
    min-width: 240px;
    background: var(--panel);
    color: var(--text);
  }
  #result-count { font-size: 0.9rem; color: var(--text-dim); }
  .hide-toggle { font-size: 0.85rem; color: var(--text-dim); display: inline-flex; align-items: center; gap: 0.35rem; }
  .hide-toggle input { margin: 0; }
  #export-hidden-btn, #clear-hidden-btn {
    font-size: 0.82rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--panel);
    color: var(--text);
    cursor: pointer;
  }
  #export-hidden-btn:hover, #clear-hidden-btn:hover { background: var(--bg); }
  #hide-help { margin: -0.5rem 0 1rem; font-size: 0.8rem; }
  .links .hide-btn {
    display: inline-block;
    margin-top: 0.4rem;
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--panel);
    color: var(--text-dim);
    cursor: pointer;
  }
  .links .hide-btn:hover { color: var(--text); border-color: var(--text-dim); }
  tbody tr.is-hidden { opacity: 0.45; }
  tbody tr.is-hidden .hide-btn { color: var(--link); border-color: var(--link); }
  .links .favorite-btn {
    display: inline-block;
    margin-top: 0.4rem;
    font-size: 1.05rem;
    line-height: 1;
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--panel);
    color: var(--text-dim);
    cursor: pointer;
  }
  .links .favorite-btn:hover { border-color: var(--favorite); }
  .links .favorite-btn.is-favorited { color: var(--favorite); border-color: var(--favorite); }
  .category-filters { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1rem; }
  .category-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--panel);
    font-size: 0.82rem;
    cursor: pointer;
    user-select: none;
  }
  .category-chip input { margin: 0; }
  .category-chip.pinned { font-weight: 600; }
  #more-tags-toggle {
    font-size: 0.82rem;
    color: var(--link);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem 0;
  }
  .category-filters.tags-collapsed .tag-chip { display: none; }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--panel);
  }
  table { border-collapse: collapse; width: 100%; min-width: 1100px; }
  thead th {
    position: sticky;
    top: 0;
    background: var(--panel);
    border-bottom: 2px solid var(--border);
    text-align: left;
    padding: 0.6rem 0.75rem;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--text-dim);
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
  }
  thead th:hover { color: var(--text); }
  thead th.sorted::after { content: " " attr(data-arrow); }
  tbody td {
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.88rem;
    vertical-align: top;
  }
  tbody tr:hover { background: #fafaf7; }
  tbody tr { border-left: 4px solid transparent; }
  tbody tr.adv-unavailable { border-left-color: var(--unavailable); }
  tbody tr.adv-outofstock { border-left-color: var(--outofstock); }
  tbody tr.adv-cheaper { border-left-color: var(--cheaper); }
  .game-title { font-weight: 600; }
  .game-thumb {
    display: block;
    width: 48px;
    height: 48px;
    object-fit: cover;
    border-radius: 6px;
    float: left;
    margin: 0 0.6rem 0.3rem 0;
    background: var(--bg);
  }
  .game-badges { margin-top: 0.3rem; display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .badge {
    display: inline-block;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .badge-coop { background: #e3f2e1; color: #2e7d32; }
  .badge-party { background: #fce4ec; color: #ad1457; }
  .badge-meta { background: var(--bg); color: var(--text-dim); font-weight: 500; border: 1px solid var(--border); }
  .rating-star { font-weight: 700; font-variant-numeric: tabular-nums; }
  .quality-pill {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
  }
  .quality-excellent { background: #e3f2e1; color: #2e7d32; }
  .quality-strong { background: #e8f0fe; color: #1a5276; }
  .quality-borderline { background: #fff3e0; color: #b8860b; }
  .quality-unproven, .quality-unlabeled { background: var(--bg); color: var(--text-dim); }
  .rating-meta { color: var(--text-dim); font-size: 0.78rem; margin-top: 0.15rem; }
  .why { color: var(--text-dim); font-size: 0.82rem; margin-top: 0.2rem; clear: left; }
  .score { font-weight: 700; font-variant-numeric: tabular-nums; }
  .advantage-badge {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #fff;
  }
  .adv-unavailable .advantage-badge { background: var(--unavailable); }
  .adv-outofstock .advantage-badge { background: var(--outofstock); }
  .adv-cheaper .advantage-badge { background: var(--cheaper); }
  .flag-badge {
    display: inline-block;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-size: 0.72rem;
    background: var(--flag-bg);
    color: var(--flag-text);
    margin-right: 0.25rem;
  }
  .links a { margin-right: 0.6rem; font-size: 0.82rem; color: var(--link); text-decoration: none; }
  .links a:hover { text-decoration: underline; }
  .links .search-link { font-style: italic; }
  .num { font-variant-numeric: tabular-nums; white-space: nowrap; }
  footer { margin-top: 2rem; color: var(--text-dim); font-size: 0.8rem; }
  tr.hidden-row { display: none; }
  #unmatched-section { margin-top: 2rem; }
  #unmatched-section summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 1.05rem;
    padding: 0.5rem 0;
  }
  #unmatched-section summary:hover { color: var(--link); }
  #unmatched-section .subtitle { margin-top: 0.25rem; }

  .mobile-sort-wrap { display: none; }

  @media (max-width: 700px) {
    body { padding: 1.25rem 1rem 3rem; }
    h1 { font-size: 1.35rem; }
    .subtitle { font-size: 0.85rem; }
    .meta { font-size: 0.78rem; }
    .controls { gap: 0.6rem; }
    .filter-input { min-width: 0; width: 100%; }
    .hide-toggle { padding: 0.4rem 0; }
    #export-hidden-btn, #clear-hidden-btn { padding: 0.6rem 0.9rem; font-size: 0.88rem; }
    .category-chip { padding: 0.45rem 0.75rem; font-size: 0.85rem; }

    /* A tap-friendly "Sort by" dropdown replaces clicking column headers, which don't exist
       in the card layout below. */
    .mobile-sort-wrap { display: block; margin-bottom: 0.85rem; }
    .mobile-sort-wrap label { display: block; font-size: 0.8rem; color: var(--text-dim); }
    .mobile-sort-select {
      display: block;
      width: 100%;
      margin-top: 0.3rem;
      padding: 0.55rem 0.7rem;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--panel);
      color: var(--text);
      font-size: 1rem;
    }

    /* Table -> stacked cards: a 10-column table has no readable layout on a phone screen, and
       the previous horizontal-scroll fallback hid the advantage badge/price/links (including
       the "Not interested" button) off-screen by default. */
    .table-wrap { overflow-x: visible; border: none; border-radius: 0; background: none; }
    table { min-width: 0; width: 100%; }
    thead { display: none; }
    tbody tr {
      display: block;
      background: var(--panel);
      border: 1px solid var(--border);
      border-left-width: 4px;
      border-radius: 10px;
      padding: 0.85rem 0.9rem;
      margin-bottom: 0.75rem;
      position: relative;
    }
    tbody td {
      display: block;
      padding: 0.3rem 0;
      border-bottom: none;
      font-size: 0.9rem;
    }
    tbody td[data-label]::before {
      content: attr(data-label);
      display: block;
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: var(--text-dim);
    }
    td.score {
      position: absolute;
      top: 0.85rem;
      right: 0.9rem;
      font-size: 1.1rem;
    }
    td.game-cell { padding-right: 3.5rem; }
    .game-thumb { width: 56px; height: 56px; margin-right: 0.75rem; }
    .game-badges { margin-top: 0.35rem; }
    .badge { font-size: 0.74rem; padding: 0.15rem 0.55rem; }

    /* Discount/Flags carry no information for most rows (only CHEAPER_UK ever has a real
       discount; most rows have no flags at all) -- rather than a "Discount: —" line repeated on
       every card, the whole line is omitted when there's nothing to show. Desktop keeps the
       "—" placeholder so the table's column alignment is untouched. */
    td.is-empty { display: none; }

    td[data-label="Rating"] { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.3rem; }
    td[data-label="Rating"]::before { width: 100%; }
    .rating-meta { width: 100%; margin-top: 0.1rem; }

    td.links { display: flex; flex-wrap: wrap; align-items: center; gap: 0.7rem 0.9rem; padding-top: 0.5rem; }
    td.links a { font-size: 0.9rem; }
    td.links .favorite-btn { margin-top: 0; padding: 0.5rem 0.7rem; font-size: 1.2rem; }
    td.links .hide-btn { margin-top: 0; margin-left: auto; padding: 0.5rem 0.9rem; font-size: 0.85rem; }
  }
</style>
</head>
<body>
  <h1>Buy in the UK? — Board Games Advisor</h1>
  <p class="subtitle">Every game from Zatu's catalogue that passed the BGG quality gate and has a genuine UK-vs-France advantage. Default sort: composite score, highest first.</p>
  <p class="meta">
    Generated {{ meta.generated_at }} · FX {{ meta.fx_gbp_eur }} GBP→EUR · discount threshold {{ (meta.discount_threshold * 100) | round(0) }}%
    {% if meta.zatu_products_count %} · {{ meta.zatu_products_count }} Zatu products harvested{% endif %}
    {% if meta.stage2_survivors_count %} · {{ meta.stage2_survivors_count }} passed quality gate{% endif %}
  </p>

  <div class="controls">
    <input id="filter" class="filter-input" type="search" placeholder="Filter by title…" autocomplete="off">
    <span id="result-count">{{ games | length }} games matched your criteria</span>
    <label class="hide-toggle"><input type="checkbox" id="show-hidden"> Show hidden (<span id="hidden-count">0</span>)</label>
    <label class="hide-toggle"><input type="checkbox" id="show-favorites-only"> Only favorites (<span id="favorites-count">0</span>)</label>
    <button type="button" id="export-hidden-btn">Export hidden list</button>
    <button type="button" id="clear-hidden-btn">Clear hidden</button>
    <button type="button" id="export-favorites-btn">Export favorites</button>
    <button type="button" id="clear-favorites-btn">Clear favorites</button>
  </div>
  <div class="mobile-sort-wrap">
    <label>Sort by
      <select id="games-sort-select" class="mobile-sort-select">
        <option value="composite_score|num|-1">Score (high → low)</option>
        <option value="composite_score|num|1">Score (low → high)</option>
        <option value="zatu_title|str|1">Game title (A → Z)</option>
        <option value="quality_shrunk|num|-1">Quality (high → low)</option>
        <option value="zatu_price_gbp|num|1">UK price (low → high)</option>
        <option value="discount_pct|num|-1">Discount (high → low)</option>
      </select>
    </label>
  </div>
  <p class="meta" id="hide-help">
    Click "Not interested" on a row to hide it, or the ♡ to favorite it (both saved in this browser, survive future
    site rebuilds automatically). To make hidden/favorited games stick for everyone / across devices, click
    "Export hidden list" / "Export favorites", save the downloaded file as <code>data/excluded_games.json</code> /
    <code>data/favorited_games.json</code> in the repo, and commit it.
  </p>

  <div class="category-filters" id="category-filters">
    <label class="category-chip pinned"><input type="checkbox" data-category="coop"> Coop</label>
    <label class="category-chip pinned"><input type="checkbox" data-category="party"> Party</label>
    {% for tag in filter_tags %}
    <label class="category-chip tag-chip"><input type="checkbox" data-category-tag="{{ tag }}"> {{ tag }}</label>
    {% endfor %}
    {% if filter_tags %}<button type="button" id="more-tags-toggle">show more tags</button>{% endif %}
  </div>

  <div class="table-wrap">
    <table id="games-table">
      <thead>
        <tr>
          <th data-key="composite_score" data-type="num">Score</th>
          <th data-key="zatu_title" data-type="str">Game</th>
          <th data-key="advantage_verdict" data-type="str">Advantage</th>
          <th data-key="quality_shrunk" data-type="num">Quality</th>
          <th data-key="zatu_price_gbp" data-type="num">GBP</th>
          <th data-key="philibert_price_eur" data-type="num">EUR</th>
          <th data-key="discount_pct" data-type="num">Discount</th>
          <th data-key="match_confidence" data-type="str">Match</th>
          <th data-key="flags_text" data-type="str">Flags</th>
          <th data-key="links" data-type="none">Links</th>
        </tr>
      </thead>
      <tbody>
        {% for game in games %}
        <tr class="{{ game.advantage_css_class }}"
            data-handle="{{ game.zatu_handle }}"
            data-user_excluded="{{ '1' if game.user_excluded else '0' }}"
            data-user_favorited="{{ '1' if game.user_favorited else '0' }}"
            data-composite_score="{{ game.composite_score }}"
            data-zatu_title="{{ game.zatu_title | lower }}"
            data-advantage_verdict="{{ game.advantage_verdict }}"
            data-quality_shrunk="{{ game.quality_shrunk }}"
            data-zatu_price_gbp="{{ game.zatu_price_gbp if game.zatu_price_gbp is not none else '' }}"
            data-philibert_price_eur="{{ game.philibert_price_eur if game.philibert_price_eur is not none else '' }}"
            data-discount_pct="{{ game.discount_pct if game.discount_pct is not none else '' }}"
            data-match_confidence="{{ game.match_confidence }}"
            data-flags_text="{{ game.flags | join(',') }}"
            data-filter-text="{{ game.zatu_title | lower }}"
            data-is-coop="{{ '1' if game.zatu_is_coop else '0' }}"
            data-is-party="{{ '1' if game.zatu_is_party else '0' }}"
            data-category-tags="{{ game.category_tags | join('|') | lower }}">
          <td class="score num" data-label="Score">{{ "%.1f" | format(game.composite_score) }}</td>
          <td class="game-cell">
            {% if game.zatu_image_url %}<img class="game-thumb" src="{{ game.zatu_image_url }}" alt="" loading="lazy">{% endif %}
            <div class="game-title">{{ game.zatu_title }}{% if game.bgg_year %} <span class="num">({{ game.bgg_year }})</span>{% endif %}</div>
            <div class="game-badges">
              {% if game.zatu_is_coop %}<span class="badge badge-coop">Coop</span>{% endif %}
              {% if game.zatu_is_party %}<span class="badge badge-party">Party</span>{% endif %}
              {% if game.player_count_tag %}<span class="badge badge-meta">{{ game.player_count_tag }}</span>{% endif %}
              {% if game.duration_tag %}<span class="badge badge-meta">{{ game.duration_tag }}</span>{% endif %}
            </div>
            <div class="why">{{ game.why }}</div>
          </td>
          <td data-label="Advantage"><span class="advantage-badge">{{ game.advantage_verdict }}</span></td>
          <td data-label="Rating">
            <span class="rating-star">★ {{ "%.1f" | format(game.bgg_average) }}</span>
            <span class="quality-pill quality-{{ game.quality_label | lower }}">{{ game.quality_label }}</span>
            <div class="num rating-meta">{{ "{:,}".format(game.bgg_usersrated) }} votes · {{ "%.2f" | format(game.quality_shrunk) }} shrunk</div>
          </td>
          <td class="num" data-label="UK price">{% if game.zatu_price_gbp is not none %}£{{ "%.2f" | format(game.zatu_price_gbp) }}{% else %}—{% endif %}</td>
          <td class="num" data-label="FR price">{% if game.philibert_price_eur is not none %}€{{ "%.2f" | format(game.philibert_price_eur) }}{% else %}—{% endif %}</td>
          <td class="num {{ 'is-empty' if game.discount_pct is none }}" data-label="Discount">{% if game.discount_pct is not none %}{{ (game.discount_pct * 100) | round(0) | int }}%{% else %}—{% endif %}</td>
          <td data-label="Match">{{ game.match_confidence }}</td>
          <td class="{{ 'is-empty' if not game.flags }}" data-label="Flags">
            {% for flag in game.flags %}<span class="flag-badge">{{ flag }}</span>{% endfor %}
          </td>
          <td class="links">
            <a href="https://boardgamegeek.com/boardgame/{{ game.bgg_id }}" target="_blank" rel="noopener">BGG</a>
            <a href="{{ game.zatu_url }}" target="_blank" rel="noopener">Zatu</a>
            <a class="{{ 'search-link' if game.philibert_link_is_search else '' }}" href="{{ game.philibert_link_url }}" target="_blank" rel="noopener">Philibert{% if game.philibert_link_is_search %} (search){% endif %}</a>
            <button type="button" class="favorite-btn" aria-pressed="{{ 'true' if game.user_favorited else 'false' }}" aria-label="Favorite this game" title="Favorite this game">♡</button>
            <button type="button" class="hide-btn">Not interested</button>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <details id="unmatched-section">
    <summary>Not matched to BGG ({{ unmatched_games | length }} games) — unscored, Zatu-only data, worth an eyeball</summary>
    <p class="subtitle">
      Zatu listings where Stage 2 genuinely tried to find a BGG match and found nothing confident enough — no
      quality/price-advantage score exists for these. Titles dropped for a known reason (a real BGG expansion,
      an ambiguous multi-edition tie, a numbered-sequel conflict) are excluded here since there's nothing to
      investigate for those. "Closest BGG guess" is shown for transparency where one exists, but it was never
      trusted automatically — always verify by hand before buying.
    </p>

    <div class="controls">
      <input id="unmatched-filter" class="filter-input" type="search" placeholder="Filter by title…" autocomplete="off">
      <span id="unmatched-result-count">{{ unmatched_games | length }} games matched your criteria</span>
      <label class="hide-toggle"><input type="checkbox" id="unmatched-show-hidden"> Show hidden (<span id="unmatched-hidden-count">0</span>)</label>
      <label class="hide-toggle"><input type="checkbox" id="unmatched-show-favorites-only"> Only favorites (<span id="unmatched-favorites-count">0</span>)</label>
      <button type="button" id="unmatched-export-hidden-btn">Export hidden list</button>
      <button type="button" id="unmatched-clear-hidden-btn">Clear hidden</button>
    </div>
    <div class="mobile-sort-wrap">
      <label>Sort by
        <select id="unmatched-sort-select" class="mobile-sort-select">
          <option value="match_score|num|-1">Closest BGG guess (high → low)</option>
          <option value="zatu_title|str|1">Game title (A → Z)</option>
          <option value="zatu_price_gbp|num|1">UK price (low → high)</option>
        </select>
      </label>
    </div>

    <div class="category-filters" id="unmatched-category-filters">
      <label class="category-chip pinned"><input type="checkbox" data-category="coop"> Coop</label>
      <label class="category-chip pinned"><input type="checkbox" data-category="party"> Party</label>
      {% for tag in unmatched_filter_tags %}
      <label class="category-chip tag-chip"><input type="checkbox" data-category-tag="{{ tag }}"> {{ tag }}</label>
      {% endfor %}
      {% if unmatched_filter_tags %}<button type="button" id="unmatched-more-tags-toggle">show more tags</button>{% endif %}
    </div>

    <div class="table-wrap">
      <table id="unmatched-games-table">
        <thead>
          <tr>
            <th data-key="zatu_title" data-type="str">Game</th>
            <th data-key="zatu_price_gbp" data-type="num">GBP</th>
            <th data-key="zatu_in_stock" data-type="str">Stock</th>
            <th data-key="match_category" data-type="str">Why unmatched</th>
            <th data-key="match_score" data-type="num">Closest BGG guess</th>
            <th data-key="links" data-type="none">Links</th>
          </tr>
        </thead>
        <tbody>
          {% for game in unmatched_games %}
          <tr data-handle="{{ game.zatu_handle }}"
              data-user_excluded="{{ '1' if game.user_excluded else '0' }}"
              data-user_favorited="{{ '1' if game.user_favorited else '0' }}"
              data-zatu_title="{{ game.zatu_title | lower }}"
              data-zatu_price_gbp="{{ game.zatu_price_gbp if game.zatu_price_gbp is not none else '' }}"
              data-zatu_in_stock="{{ 'in stock' if game.zatu_in_stock else 'out of stock' }}"
              data-match_category="{{ game.match_category }}"
              data-match_score="{{ game.match_score if game.match_score is not none else '' }}"
              data-filter-text="{{ game.zatu_title | lower }}"
              data-is-coop="{{ '1' if game.zatu_is_coop else '0' }}"
              data-is-party="{{ '1' if game.zatu_is_party else '0' }}"
              data-category-tags="{{ game.category_tags | join('|') | lower }}">
            <td class="game-title">{{ game.zatu_title }}</td>
            <td class="num" data-label="UK price">{% if game.zatu_price_gbp is not none %}£{{ "%.2f" | format(game.zatu_price_gbp) }}{% else %}—{% endif %}</td>
            <td data-label="Stock">{{ 'In stock' if game.zatu_in_stock else 'Out of stock' }}</td>
            <td data-label="Why unmatched">{{ game.match_category_label }}</td>
            <td data-label="Closest BGG guess">{{ game.closest_bgg_guess or '—' }}</td>
            <td class="links">
              <a href="{{ game.zatu_url }}" target="_blank" rel="noopener">Zatu</a>
              <a class="search-link" href="{{ game.bgg_search_url }}" target="_blank" rel="noopener">BGG (search)</a>
              <button type="button" class="favorite-btn" aria-pressed="{{ 'true' if game.user_favorited else 'false' }}" aria-label="Favorite this game" title="Favorite this game">♡</button>
              <button type="button" class="hide-btn">Not interested</button>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </details>

  <footer>
    Zatu is the universe: a game not sold by Zatu is out of scope. Ambiguous BGG/Philibert matches are dropped, not guessed.
    Language dependence is shown when BGG's own community poll data is known for a game; not every game has been checked yet.
    Treat this as a shortlist to verify on arrival, not a guarantee.
  </footer>

<script>
(function () {
  var HIDE_STORAGE_KEY = 'ukbg_hidden_handles';
  var FAVORITE_STORAGE_KEY = 'ukbg_favorited_handles';

  function loadHiddenSet(seedHandles) {
    var raw = null;
    try { raw = localStorage.getItem(HIDE_STORAGE_KEY); } catch (e) { /* storage unavailable */ }
    if (raw !== null) {
      try { return new Set(JSON.parse(raw)); } catch (e) { /* corrupt, fall through */ }
    }
    // First-ever visit from this browser: seed from whatever's already baked into the page
    // (data/excluded_games.json), so a fresh browser starts in sync with the committed list.
    return new Set(seedHandles);
  }

  function saveHiddenSet(set) {
    try { localStorage.setItem(HIDE_STORAGE_KEY, JSON.stringify(Array.from(set))); }
    catch (e) { /* storage unavailable (private browsing, quota) -- hiding still works this tab */ }
  }

  function loadFavoriteSet(seedHandles) {
    var raw = null;
    try { raw = localStorage.getItem(FAVORITE_STORAGE_KEY); } catch (e) { /* storage unavailable */ }
    if (raw !== null) {
      try { return new Set(JSON.parse(raw)); } catch (e) { /* corrupt, fall through */ }
    }
    return new Set(seedHandles);
  }

  function saveFavoriteSet(set) {
    try { localStorage.setItem(FAVORITE_STORAGE_KEY, JSON.stringify(Array.from(set))); }
    catch (e) { /* storage unavailable */ }
  }

  // Favorites are one set shared by both tables (a game only ever appears in one of them, but
  // the storage/export/clear controls are global) -- loaded once here, seeded from whichever
  // rows either table baked in as already-favorited (data/favorited_games.json), before either
  // table is set up.
  var allHandleRows = Array.prototype.slice.call(document.querySelectorAll('tbody tr[data-handle]'));
  var favoriteSeed = allHandleRows.filter(function (row) { return row.dataset.user_favorited === '1'; })
    .map(function (row) { return row.dataset.handle; });
  var favoriteSet = loadFavoriteSet(favoriteSeed);
  var tableRefreshers = [];

  function refreshFavoriteButton(row) {
    var btn = row.querySelector('.favorite-btn');
    if (!btn) return;
    var isFav = favoriteSet.has(row.dataset.handle);
    btn.textContent = isFav ? '♥' : '♡';
    btn.classList.toggle('is-favorited', isFav);
    btn.setAttribute('aria-pressed', isFav ? 'true' : 'false');
  }

  function setupTable(opts) {
    var table = document.getElementById(opts.tableId);
    if (!table) return;
    var tbody = table.querySelector('tbody');
    var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
    var headers = table.querySelectorAll('thead th');
    var currentSort = { key: opts.defaultSortKey, dir: opts.defaultSortDir };

    var hiddenSet = null;
    var showHiddenBox = null;
    var hiddenCountEl = null;

    function refreshHideButton(row) {
      var btn = row.querySelector('.hide-btn');
      if (!btn) return;
      var isHidden = hiddenSet.has(row.dataset.handle);
      btn.textContent = isHidden ? 'Un-hide' : 'Not interested';
      row.classList.toggle('is-hidden', isHidden);
    }

    if (opts.enableHide) {
      var seedHandles = rows.filter(function (row) { return row.dataset.user_excluded === '1'; })
        .map(function (row) { return row.dataset.handle; });
      hiddenSet = loadHiddenSet(seedHandles);
      showHiddenBox = document.getElementById(opts.showHiddenId);
      hiddenCountEl = document.getElementById(opts.hiddenCountId);

      rows.forEach(function (row) {
        refreshHideButton(row);
        var btn = row.querySelector('.hide-btn');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var handle = row.dataset.handle;
          if (hiddenSet.has(handle)) { hiddenSet.delete(handle); } else { hiddenSet.add(handle); }
          saveHiddenSet(hiddenSet);
          refreshHideButton(row);
          applyFilters();
        });
      });

      if (showHiddenBox) showHiddenBox.addEventListener('change', applyFilters);

      var exportBtn = document.getElementById(opts.exportButtonId);
      if (exportBtn) {
        exportBtn.addEventListener('click', function () {
          var handles = Array.from(hiddenSet).sort();
          var payload = JSON.stringify({ excluded_handles: handles }, null, 2) + '\n';
          var blob = new Blob([payload], { type: 'application/json' });
          var url = URL.createObjectURL(blob);
          var a = document.createElement('a');
          a.href = url;
          a.download = 'excluded_games.json';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
        });
      }

      var clearBtn = document.getElementById(opts.clearButtonId);
      if (clearBtn) {
        clearBtn.addEventListener('click', function () {
          hiddenSet.clear();
          saveHiddenSet(hiddenSet);
          rows.forEach(refreshHideButton);
          applyFilters();
        });
      }
    }

    var showFavoritesOnlyBox = opts.showFavoritesOnlyId ? document.getElementById(opts.showFavoritesOnlyId) : null;
    var favoritesCountEl = opts.favoritesCountId ? document.getElementById(opts.favoritesCountId) : null;

    if (opts.enableFavorite) {
      rows.forEach(function (row) {
        refreshFavoriteButton(row);
        var btn = row.querySelector('.favorite-btn');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var handle = row.dataset.handle;
          if (favoriteSet.has(handle)) { favoriteSet.delete(handle); } else { favoriteSet.add(handle); }
          saveFavoriteSet(favoriteSet);
          refreshFavoriteButton(row);
          applyFilters();
        });
      });
      if (showFavoritesOnlyBox) showFavoritesOnlyBox.addEventListener('change', applyFilters);
    }

    function sortRows(key, type, dir) {
      rows.sort(function (a, b) {
        var av = a.dataset[key];
        var bv = b.dataset[key];
        if (type === 'num') {
          av = av === '' ? -Infinity : parseFloat(av);
          bv = bv === '' ? -Infinity : parseFloat(bv);
          return (av - bv) * dir;
        }
        av = (av || '').toString();
        bv = (bv || '').toString();
        return av.localeCompare(bv) * dir;
      });
      rows.forEach(function (row) { tbody.appendChild(row); });
    }

    function applySortAndMarkHeader(key, type, dir) {
      currentSort = { key: key, dir: dir };
      headers.forEach(function (h) { h.classList.remove('sorted'); h.removeAttribute('data-arrow'); });
      var th = table.querySelector('th[data-key="' + key + '"]');
      if (th) {
        th.classList.add('sorted');
        th.setAttribute('data-arrow', dir === 1 ? '▲' : '▼');
      }
      sortRows(key, type, dir);
    }

    headers.forEach(function (th) {
      var key = th.dataset.key;
      var type = th.dataset.type;
      if (type === 'none') return;
      th.addEventListener('click', function () {
        var dir = (currentSort.key === key && currentSort.dir === -1) ? 1 : -1;
        applySortAndMarkHeader(key, type, dir);
      });
    });

    // Column headers aren't clickable in the mobile card layout (no header row) -- this
    // dropdown, CSS-hidden above 700px, is the mobile equivalent.
    var sortSelect = document.getElementById(opts.sortSelectId);
    if (sortSelect) {
      sortSelect.addEventListener('change', function () {
        var parts = sortSelect.value.split('|');
        applySortAndMarkHeader(parts[0], parts[1], parseInt(parts[2], 10));
      });
    }

    // Initial sort, per table.
    sortRows(opts.defaultSortKey, opts.defaultSortType, opts.defaultSortDir);
    var defaultHeader = table.querySelector('th[data-key="' + opts.defaultSortKey + '"]');
    defaultHeader.classList.add('sorted');
    defaultHeader.setAttribute('data-arrow', opts.defaultSortDir === 1 ? '▲' : '▼');

    var filterInput = document.getElementById(opts.filterId);
    var resultCount = document.getElementById(opts.resultCountId);
    var categoryFilters = document.getElementById(opts.categoryFiltersId);
    var coopBox = categoryFilters.querySelector('[data-category="coop"]');
    var partyBox = categoryFilters.querySelector('[data-category="party"]');
    var tagBoxes = Array.prototype.slice.call(categoryFilters.querySelectorAll('[data-category-tag]'));

    function applyFilters() {
      var needle = filterInput.value.trim().toLowerCase();
      var checkedTags = tagBoxes.filter(function (el) { return el.checked; })
        .map(function (el) { return el.dataset.categoryTag.toLowerCase(); });
      var anyCategorySelected = coopBox.checked || partyBox.checked || checkedTags.length > 0;
      var visible = 0;
      rows.forEach(function (row) {
        var textMatch = row.dataset.filterText.indexOf(needle) !== -1;
        var categoryMatch = !anyCategorySelected;
        if (!categoryMatch) {
          if (coopBox.checked && row.dataset.isCoop === '1') categoryMatch = true;
          if (partyBox.checked && row.dataset.isParty === '1') categoryMatch = true;
          if (checkedTags.length) {
            var rowTags = row.dataset.categoryTags ? row.dataset.categoryTags.split('|') : [];
            for (var i = 0; i < checkedTags.length; i++) {
              if (rowTags.indexOf(checkedTags[i]) !== -1) { categoryMatch = true; break; }
            }
          }
        }
        var hideOk = true;
        if (opts.enableHide) {
          var isHidden = hiddenSet.has(row.dataset.handle);
          hideOk = !isHidden || (showHiddenBox && showHiddenBox.checked);
        }
        var favoriteOk = true;
        if (opts.enableFavorite && showFavoritesOnlyBox && showFavoritesOnlyBox.checked) {
          favoriteOk = favoriteSet.has(row.dataset.handle);
        }
        var match = textMatch && categoryMatch && hideOk && favoriteOk;
        row.classList.toggle('hidden-row', !match);
        if (match) visible++;
      });
      resultCount.textContent = visible + opts.resultSuffix;
      if (opts.enableHide && hiddenCountEl) hiddenCountEl.textContent = hiddenSet.size;
      if (opts.enableFavorite && favoritesCountEl) {
        favoritesCountEl.textContent = rows.filter(function (row) { return favoriteSet.has(row.dataset.handle); }).length;
      }
    }

    filterInput.addEventListener('input', applyFilters);
    categoryFilters.querySelectorAll('input[type=checkbox]').forEach(function (el) {
      el.addEventListener('change', applyFilters);
    });

    var moreTagsToggle = document.getElementById(opts.moreTagsToggleId);
    if (moreTagsToggle) {
      categoryFilters.classList.add('tags-collapsed');
      moreTagsToggle.addEventListener('click', function () {
        var collapsed = categoryFilters.classList.toggle('tags-collapsed');
        moreTagsToggle.textContent = collapsed ? 'show more tags' : 'show fewer tags';
      });
    }

    if (opts.enableHide || opts.enableFavorite) applyFilters();

    if (opts.enableFavorite) {
      tableRefreshers.push(function () {
        rows.forEach(refreshFavoriteButton);
        applyFilters();
      });
    }
  }

  setupTable({
    tableId: 'games-table',
    filterId: 'filter',
    resultCountId: 'result-count',
    categoryFiltersId: 'category-filters',
    moreTagsToggleId: 'more-tags-toggle',
    defaultSortKey: 'composite_score',
    defaultSortType: 'num',
    defaultSortDir: -1,
    resultSuffix: ' games matched your criteria',
    enableHide: true,
    showHiddenId: 'show-hidden',
    hiddenCountId: 'hidden-count',
    exportButtonId: 'export-hidden-btn',
    clearButtonId: 'clear-hidden-btn',
    sortSelectId: 'games-sort-select',
    enableFavorite: true,
    showFavoritesOnlyId: 'show-favorites-only',
    favoritesCountId: 'favorites-count',
  });

  setupTable({
    tableId: 'unmatched-games-table',
    filterId: 'unmatched-filter',
    resultCountId: 'unmatched-result-count',
    categoryFiltersId: 'unmatched-category-filters',
    moreTagsToggleId: 'unmatched-more-tags-toggle',
    // Highest fuzzy score first -- near-misses (most likely to be a real overlooked match) sort
    // above genuine no-BGG-candidate cases, which carry no score at all.
    defaultSortKey: 'match_score',
    defaultSortType: 'num',
    defaultSortDir: -1,
    resultSuffix: ' games matched your criteria',
    sortSelectId: 'unmatched-sort-select',
    enableHide: true,
    showHiddenId: 'unmatched-show-hidden',
    hiddenCountId: 'unmatched-hidden-count',
    exportButtonId: 'unmatched-export-hidden-btn',
    clearButtonId: 'unmatched-clear-hidden-btn',
    enableFavorite: true,
    showFavoritesOnlyId: 'unmatched-show-favorites-only',
    favoritesCountId: 'unmatched-favorites-count',
  });

  // Export/Clear operate on the one favoriteSet shared by both tables -- wired once here rather
  // than per-table, then every table's own buttons/counts are refreshed via tableRefreshers.
  var exportFavoritesBtn = document.getElementById('export-favorites-btn');
  if (exportFavoritesBtn) {
    exportFavoritesBtn.addEventListener('click', function () {
      var handles = Array.from(favoriteSet).sort();
      var payload = JSON.stringify({ favorited_handles: handles }, null, 2) + '\n';
      var blob = new Blob([payload], { type: 'application/json' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = 'favorited_games.json';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });
  }

  var clearFavoritesBtn = document.getElementById('clear-favorites-btn');
  if (clearFavoritesBtn) {
    clearFavoritesBtn.addEventListener('click', function () {
      favoriteSet.clear();
      saveFavoriteSet(favoriteSet);
      tableRefreshers.forEach(function (refresh) { refresh(); });
    });
  }
})();
</script>
</body>
</html>
