<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Buy in the UK? — Board Games Advisor</title>
<style>
  :root {
    --bg: #f7f7f5;
    --panel: #ffffff;
    --border: #e2e0da;
    --text: #24211c;
    --text-dim: #6b6559;
    --link: #1a5276;
    --unavailable: #2e7d32;
    --outofstock: #b8860b;
    --cheaper: #1565c0;
    --flag-bg: #fdecea;
    --flag-text: #b71c1c;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 2rem 1.5rem 4rem;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  h1 { margin: 0 0 0.25rem; font-size: 1.6rem; }
  .subtitle { color: var(--text-dim); margin: 0 0 1.25rem; font-size: 0.95rem; }
  .meta { color: var(--text-dim); font-size: 0.85rem; margin-bottom: 1.5rem; }
  .controls {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  #filter {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.95rem;
    min-width: 240px;
    background: var(--panel);
    color: var(--text);
  }
  #result-count { font-size: 0.9rem; color: var(--text-dim); }
  .hide-toggle { font-size: 0.85rem; color: var(--text-dim); display: inline-flex; align-items: center; gap: 0.35rem; }
  .hide-toggle input { margin: 0; }
  #export-hidden-btn, #clear-hidden-btn {
    font-size: 0.82rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--panel);
    color: var(--text);
    cursor: pointer;
  }
  #export-hidden-btn:hover, #clear-hidden-btn:hover { background: var(--bg); }
  #hide-help { margin: -0.5rem 0 1rem; font-size: 0.8rem; }
  .links .hide-btn {
    display: inline-block;
    margin-top: 0.4rem;
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--panel);
    color: var(--text-dim);
    cursor: pointer;
  }
  .links .hide-btn:hover { color: var(--text); border-color: var(--text-dim); }
  tbody tr.is-hidden { opacity: 0.45; }
  tbody tr.is-hidden .hide-btn { color: var(--link); border-color: var(--link); }
  .category-filters { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1rem; }
  .category-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--panel);
    font-size: 0.82rem;
    cursor: pointer;
    user-select: none;
  }
  .category-chip input { margin: 0; }
  .category-chip.pinned { font-weight: 600; }
  #more-tags-toggle {
    font-size: 0.82rem;
    color: var(--link);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem 0;
  }
  .category-filters.tags-collapsed .tag-chip { display: none; }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--panel);
  }
  table { border-collapse: collapse; width: 100%; min-width: 1100px; }
  thead th {
    position: sticky;
    top: 0;
    background: var(--panel);
    border-bottom: 2px solid var(--border);
    text-align: left;
    padding: 0.6rem 0.75rem;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--text-dim);
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
  }
  thead th:hover { color: var(--text); }
  thead th.sorted::after { content: " " attr(data-arrow); }
  tbody td {
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.88rem;
    vertical-align: top;
  }
  tbody tr:hover { background: #fafaf7; }
  tbody tr { border-left: 4px solid transparent; }
  tbody tr.adv-unavailable { border-left-color: var(--unavailable); }
  tbody tr.adv-outofstock { border-left-color: var(--outofstock); }
  tbody tr.adv-cheaper { border-left-color: var(--cheaper); }
  .game-title { font-weight: 600; }
  .why { color: var(--text-dim); font-size: 0.82rem; margin-top: 0.2rem; }
  .score { font-weight: 700; font-variant-numeric: tabular-nums; }
  .advantage-badge {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #fff;
  }
  .adv-unavailable .advantage-badge { background: var(--unavailable); }
  .adv-outofstock .advantage-badge { background: var(--outofstock); }
  .adv-cheaper .advantage-badge { background: var(--cheaper); }
  .flag-badge {
    display: inline-block;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-size: 0.72rem;
    background: var(--flag-bg);
    color: var(--flag-text);
    margin-right: 0.25rem;
  }
  .links a { margin-right: 0.6rem; font-size: 0.82rem; color: var(--link); text-decoration: none; }
  .links a:hover { text-decoration: underline; }
  .links .search-link { font-style: italic; }
  .num { font-variant-numeric: tabular-nums; white-space: nowrap; }
  footer { margin-top: 2rem; color: var(--text-dim); font-size: 0.8rem; }
  tr.hidden-row { display: none; }
  #unmatched-section { margin-top: 2rem; }
  #unmatched-section summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 1.05rem;
    padding: 0.5rem 0;
  }
  #unmatched-section summary:hover { color: var(--link); }
  #unmatched-section .subtitle { margin-top: 0.25rem; }
</style>
</head>
<body>
  <h1>Buy in the UK? — Board Games Advisor</h1>
  <p class="subtitle">Every game from Zatu's catalogue that passed the BGG quality gate and has a genuine UK-vs-France advantage. Default sort: composite score, highest first.</p>
  <p class="meta">
    Generated {{ meta.generated_at }} · FX {{ meta.fx_gbp_eur }} GBP→EUR · discount threshold {{ (meta.discount_threshold * 100) | round(0) }}%
    {% if meta.zatu_products_count %} · {{ meta.zatu_products_count }} Zatu products harvested{% endif %}
    {% if meta.stage2_survivors_count %} · {{ meta.stage2_survivors_count }} passed quality gate{% endif %}
  </p>

  <div class="controls">
    <input id="filter" type="search" placeholder="Filter by title…" autocomplete="off">
    <span id="result-count">{{ games | length }} games matched your criteria</span>
    <label class="hide-toggle"><input type="checkbox" id="show-hidden"> Show hidden (<span id="hidden-count">0</span>)</label>
    <button type="button" id="export-hidden-btn">Export hidden list</button>
    <button type="button" id="clear-hidden-btn">Clear hidden</button>
  </div>
  <p class="meta" id="hide-help">
    Click "Not interested" on a row to hide it (saved in this browser, survives future site rebuilds automatically).
    To make hidden games stay hidden for everyone / across devices, click "Export hidden list", save the downloaded
    file as <code>data/excluded_games.json</code> in the repo, and commit it.
  </p>

  <div class="category-filters" id="category-filters">
    <label class="category-chip pinned"><input type="checkbox" data-category="coop"> Coop</label>
    <label class="category-chip pinned"><input type="checkbox" data-category="party"> Party</label>
    {% for tag in filter_tags %}
    <label class="category-chip tag-chip"><input type="checkbox" data-category-tag="{{ tag }}"> {{ tag }}</label>
    {% endfor %}
    {% if filter_tags %}<button type="button" id="more-tags-toggle">show more tags</button>{% endif %}
  </div>

  <div class="table-wrap">
    <table id="games-table">
      <thead>
        <tr>
          <th data-key="composite_score" data-type="num">Score</th>
          <th data-key="zatu_title" data-type="str">Game</th>
          <th data-key="advantage_verdict" data-type="str">Advantage</th>
          <th data-key="quality_shrunk" data-type="num">Quality</th>
          <th data-key="zatu_price_gbp" data-type="num">GBP</th>
          <th data-key="philibert_price_eur" data-type="num">EUR</th>
          <th data-key="discount_pct" data-type="num">Discount</th>
          <th data-key="match_confidence" data-type="str">Match</th>
          <th data-key="flags_text" data-type="str">Flags</th>
          <th data-key="links" data-type="none">Links</th>
        </tr>
      </thead>
      <tbody>
        {% for game in games %}
        <tr class="{{ game.advantage_css_class }}"
            data-handle="{{ game.zatu_handle }}"
            data-user_excluded="{{ '1' if game.user_excluded else '0' }}"
            data-composite_score="{{ game.composite_score }}"
            data-zatu_title="{{ game.zatu_title | lower }}"
            data-advantage_verdict="{{ game.advantage_verdict }}"
            data-quality_shrunk="{{ game.quality_shrunk }}"
            data-zatu_price_gbp="{{ game.zatu_price_gbp if game.zatu_price_gbp is not none else '' }}"
            data-philibert_price_eur="{{ game.philibert_price_eur if game.philibert_price_eur is not none else '' }}"
            data-discount_pct="{{ game.discount_pct if game.discount_pct is not none else '' }}"
            data-match_confidence="{{ game.match_confidence }}"
            data-flags_text="{{ game.flags | join(',') }}"
            data-filter-text="{{ game.zatu_title | lower }}"
            data-is-coop="{{ '1' if game.zatu_is_coop else '0' }}"
            data-is-party="{{ '1' if game.zatu_is_party else '0' }}"
            data-category-tags="{{ game.category_tags | join('|') | lower }}">
          <td class="score num">{{ "%.1f" | format(game.composite_score) }}</td>
          <td>
            <div class="game-title">{{ game.zatu_title }}{% if game.bgg_year %} <span class="num">({{ game.bgg_year }})</span>{% endif %}</div>
            <div class="why">{{ game.why }}</div>
          </td>
          <td><span class="advantage-badge">{{ game.advantage_verdict }}</span></td>
          <td>
            {{ game.quality_label }}<br>
            <span class="num">{{ "%.2f" | format(game.quality_shrunk) }} shrunk · {{ "%.2f" | format(game.bgg_average) }} raw · {{ "{:,}".format(game.bgg_usersrated) }} votes</span>
          </td>
          <td class="num">{% if game.zatu_price_gbp is not none %}£{{ "%.2f" | format(game.zatu_price_gbp) }}{% else %}—{% endif %}</td>
          <td class="num">{% if game.philibert_price_eur is not none %}€{{ "%.2f" | format(game.philibert_price_eur) }}{% else %}—{% endif %}</td>
          <td class="num">{% if game.discount_pct is not none %}{{ (game.discount_pct * 100) | round(0) | int }}%{% else %}—{% endif %}</td>
          <td>{{ game.match_confidence }}</td>
          <td>
            {% for flag in game.flags %}<span class="flag-badge">{{ flag }}</span>{% endfor %}
          </td>
          <td class="links">
            <a href="https://boardgamegeek.com/boardgame/{{ game.bgg_id }}" target="_blank" rel="noopener">BGG</a>
            <a href="{{ game.zatu_url }}" target="_blank" rel="noopener">Zatu</a>
            <a class="{{ 'search-link' if game.philibert_link_is_search else '' }}" href="{{ game.philibert_link_url }}" target="_blank" rel="noopener">Philibert{% if game.philibert_link_is_search %} (search){% endif %}</a>
            <button type="button" class="hide-btn">Not interested</button>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <details id="unmatched-section">
    <summary>Not matched to BGG ({{ unmatched_games | length }} games) — unscored, Zatu-only data, worth an eyeball</summary>
    <p class="subtitle">
      These Zatu listings never got a confident BGG match (or matched more than one BGG entry) at all — Stage 2's
      precision-first matcher deliberately drops anything it isn't sure about rather than guessing, so there's no
      quality/price-advantage score for these. "Closest BGG guess" is shown for transparency where one exists, but
      it was never trusted automatically — always verify by hand before buying.
    </p>

    <div class="controls">
      <input id="unmatched-filter" type="search" placeholder="Filter by title…" autocomplete="off">
      <span id="unmatched-result-count">{{ unmatched_games | length }} games matched your criteria</span>
    </div>

    <div class="category-filters" id="unmatched-category-filters">
      <label class="category-chip pinned"><input type="checkbox" data-category="coop"> Coop</label>
      <label class="category-chip pinned"><input type="checkbox" data-category="party"> Party</label>
      {% for tag in unmatched_filter_tags %}
      <label class="category-chip tag-chip"><input type="checkbox" data-category-tag="{{ tag }}"> {{ tag }}</label>
      {% endfor %}
      {% if unmatched_filter_tags %}<button type="button" id="unmatched-more-tags-toggle">show more tags</button>{% endif %}
    </div>

    <div class="table-wrap">
      <table id="unmatched-games-table">
        <thead>
          <tr>
            <th data-key="zatu_title" data-type="str">Game</th>
            <th data-key="zatu_price_gbp" data-type="num">GBP</th>
            <th data-key="zatu_in_stock" data-type="str">Stock</th>
            <th data-key="match_category" data-type="str">Why unmatched</th>
            <th data-key="match_score" data-type="num">Closest BGG guess</th>
            <th data-key="links" data-type="none">Links</th>
          </tr>
        </thead>
        <tbody>
          {% for game in unmatched_games %}
          <tr data-zatu_title="{{ game.zatu_title | lower }}"
              data-zatu_price_gbp="{{ game.zatu_price_gbp if game.zatu_price_gbp is not none else '' }}"
              data-zatu_in_stock="{{ 'in stock' if game.zatu_in_stock else 'out of stock' }}"
              data-match_category="{{ game.match_category }}"
              data-match_score="{{ game.match_score if game.match_score is not none else '' }}"
              data-filter-text="{{ game.zatu_title | lower }}"
              data-is-coop="{{ '1' if game.zatu_is_coop else '0' }}"
              data-is-party="{{ '1' if game.zatu_is_party else '0' }}"
              data-category-tags="{{ game.category_tags | join('|') | lower }}">
            <td class="game-title">{{ game.zatu_title }}</td>
            <td class="num">{% if game.zatu_price_gbp is not none %}£{{ "%.2f" | format(game.zatu_price_gbp) }}{% else %}—{% endif %}</td>
            <td>{{ 'In stock' if game.zatu_in_stock else 'Out of stock' }}</td>
            <td>{{ game.match_category_label }}</td>
            <td>{{ game.closest_bgg_guess or '—' }}</td>
            <td class="links">
              <a href="{{ game.zatu_url }}" target="_blank" rel="noopener">Zatu</a>
              <a class="search-link" href="{{ game.bgg_search_url }}" target="_blank" rel="noopener">BGG (search)</a>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </details>

  <footer>
    Zatu is the universe: a game not sold by Zatu is out of scope. Ambiguous BGG/Philibert matches are dropped, not guessed.
    Language dependence isn't scored yet (BGG enrich, Stage 3, is pending) — every row currently carries the conservative UNKNOWN_LANG flag.
    Treat this as a shortlist to verify on arrival, not a guarantee.
  </footer>

<script>
(function () {
  var HIDE_STORAGE_KEY = 'ukbg_hidden_handles';

  function loadHiddenSet(seedHandles) {
    var raw = null;
    try { raw = localStorage.getItem(HIDE_STORAGE_KEY); } catch (e) { /* storage unavailable */ }
    if (raw !== null) {
      try { return new Set(JSON.parse(raw)); } catch (e) { /* corrupt, fall through */ }
    }
    // First-ever visit from this browser: seed from whatever's already baked into the page
    // (data/excluded_games.json), so a fresh browser starts in sync with the committed list.
    return new Set(seedHandles);
  }

  function saveHiddenSet(set) {
    try { localStorage.setItem(HIDE_STORAGE_KEY, JSON.stringify(Array.from(set))); }
    catch (e) { /* storage unavailable (private browsing, quota) -- hiding still works this tab */ }
  }

  function setupTable(opts) {
    var table = document.getElementById(opts.tableId);
    if (!table) return;
    var tbody = table.querySelector('tbody');
    var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
    var headers = table.querySelectorAll('thead th');
    var currentSort = { key: opts.defaultSortKey, dir: opts.defaultSortDir };

    var hiddenSet = null;
    var showHiddenBox = null;
    var hiddenCountEl = null;

    function refreshHideButton(row) {
      var btn = row.querySelector('.hide-btn');
      if (!btn) return;
      var isHidden = hiddenSet.has(row.dataset.handle);
      btn.textContent = isHidden ? 'Un-hide' : 'Not interested';
      row.classList.toggle('is-hidden', isHidden);
    }

    if (opts.enableHide) {
      var seedHandles = rows.filter(function (row) { return row.dataset.user_excluded === '1'; })
        .map(function (row) { return row.dataset.handle; });
      hiddenSet = loadHiddenSet(seedHandles);
      showHiddenBox = document.getElementById(opts.showHiddenId);
      hiddenCountEl = document.getElementById(opts.hiddenCountId);

      rows.forEach(function (row) {
        refreshHideButton(row);
        var btn = row.querySelector('.hide-btn');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var handle = row.dataset.handle;
          if (hiddenSet.has(handle)) { hiddenSet.delete(handle); } else { hiddenSet.add(handle); }
          saveHiddenSet(hiddenSet);
          refreshHideButton(row);
          applyFilters();
        });
      });

      if (showHiddenBox) showHiddenBox.addEventListener('change', applyFilters);

      var exportBtn = document.getElementById(opts.exportButtonId);
      if (exportBtn) {
        exportBtn.addEventListener('click', function () {
          var handles = Array.from(hiddenSet).sort();
          var payload = JSON.stringify({ excluded_handles: handles }, null, 2) + '\n';
          var blob = new Blob([payload], { type: 'application/json' });
          var url = URL.createObjectURL(blob);
          var a = document.createElement('a');
          a.href = url;
          a.download = 'excluded_games.json';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
        });
      }

      var clearBtn = document.getElementById(opts.clearButtonId);
      if (clearBtn) {
        clearBtn.addEventListener('click', function () {
          hiddenSet.clear();
          saveHiddenSet(hiddenSet);
          rows.forEach(refreshHideButton);
          applyFilters();
        });
      }
    }

    function sortRows(key, type, dir) {
      rows.sort(function (a, b) {
        var av = a.dataset[key];
        var bv = b.dataset[key];
        if (type === 'num') {
          av = av === '' ? -Infinity : parseFloat(av);
          bv = bv === '' ? -Infinity : parseFloat(bv);
          return (av - bv) * dir;
        }
        av = (av || '').toString();
        bv = (bv || '').toString();
        return av.localeCompare(bv) * dir;
      });
      rows.forEach(function (row) { tbody.appendChild(row); });
    }

    headers.forEach(function (th) {
      var key = th.dataset.key;
      var type = th.dataset.type;
      if (type === 'none') return;
      th.addEventListener('click', function () {
        var dir = (currentSort.key === key && currentSort.dir === -1) ? 1 : -1;
        currentSort = { key: key, dir: dir };
        headers.forEach(function (h) { h.classList.remove('sorted'); h.removeAttribute('data-arrow'); });
        th.classList.add('sorted');
        th.setAttribute('data-arrow', dir === 1 ? '▲' : '▼');
        sortRows(key, type, dir);
      });
    });

    // Initial sort, per table.
    sortRows(opts.defaultSortKey, opts.defaultSortType, opts.defaultSortDir);
    var defaultHeader = table.querySelector('th[data-key="' + opts.defaultSortKey + '"]');
    defaultHeader.classList.add('sorted');
    defaultHeader.setAttribute('data-arrow', opts.defaultSortDir === 1 ? '▲' : '▼');

    var filterInput = document.getElementById(opts.filterId);
    var resultCount = document.getElementById(opts.resultCountId);
    var categoryFilters = document.getElementById(opts.categoryFiltersId);
    var coopBox = categoryFilters.querySelector('[data-category="coop"]');
    var partyBox = categoryFilters.querySelector('[data-category="party"]');
    var tagBoxes = Array.prototype.slice.call(categoryFilters.querySelectorAll('[data-category-tag]'));

    function applyFilters() {
      var needle = filterInput.value.trim().toLowerCase();
      var checkedTags = tagBoxes.filter(function (el) { return el.checked; })
        .map(function (el) { return el.dataset.categoryTag.toLowerCase(); });
      var anyCategorySelected = coopBox.checked || partyBox.checked || checkedTags.length > 0;
      var visible = 0;
      rows.forEach(function (row) {
        var textMatch = row.dataset.filterText.indexOf(needle) !== -1;
        var categoryMatch = !anyCategorySelected;
        if (!categoryMatch) {
          if (coopBox.checked && row.dataset.isCoop === '1') categoryMatch = true;
          if (partyBox.checked && row.dataset.isParty === '1') categoryMatch = true;
          if (checkedTags.length) {
            var rowTags = row.dataset.categoryTags ? row.dataset.categoryTags.split('|') : [];
            for (var i = 0; i < checkedTags.length; i++) {
              if (rowTags.indexOf(checkedTags[i]) !== -1) { categoryMatch = true; break; }
            }
          }
        }
        var hideOk = true;
        if (opts.enableHide) {
          var isHidden = hiddenSet.has(row.dataset.handle);
          hideOk = !isHidden || (showHiddenBox && showHiddenBox.checked);
        }
        var match = textMatch && categoryMatch && hideOk;
        row.classList.toggle('hidden-row', !match);
        if (match) visible++;
      });
      resultCount.textContent = visible + opts.resultSuffix;
      if (opts.enableHide && hiddenCountEl) hiddenCountEl.textContent = hiddenSet.size;
    }

    filterInput.addEventListener('input', applyFilters);
    categoryFilters.querySelectorAll('input[type=checkbox]').forEach(function (el) {
      el.addEventListener('change', applyFilters);
    });

    var moreTagsToggle = document.getElementById(opts.moreTagsToggleId);
    if (moreTagsToggle) {
      categoryFilters.classList.add('tags-collapsed');
      moreTagsToggle.addEventListener('click', function () {
        var collapsed = categoryFilters.classList.toggle('tags-collapsed');
        moreTagsToggle.textContent = collapsed ? 'show more tags' : 'show fewer tags';
      });
    }

    if (opts.enableHide) applyFilters();
  }

  setupTable({
    tableId: 'games-table',
    filterId: 'filter',
    resultCountId: 'result-count',
    categoryFiltersId: 'category-filters',
    moreTagsToggleId: 'more-tags-toggle',
    defaultSortKey: 'composite_score',
    defaultSortType: 'num',
    defaultSortDir: -1,
    resultSuffix: ' games matched your criteria',
    enableHide: true,
    showHiddenId: 'show-hidden',
    hiddenCountId: 'hidden-count',
    exportButtonId: 'export-hidden-btn',
    clearButtonId: 'clear-hidden-btn',
  });

  setupTable({
    tableId: 'unmatched-games-table',
    filterId: 'unmatched-filter',
    resultCountId: 'unmatched-result-count',
    categoryFiltersId: 'unmatched-category-filters',
    moreTagsToggleId: 'unmatched-more-tags-toggle',
    // Highest fuzzy score first -- near-misses (most likely to be a real overlooked match) sort
    // above genuine no-BGG-candidate cases, which carry no score at all.
    defaultSortKey: 'match_score',
    defaultSortType: 'num',
    defaultSortDir: -1,
    resultSuffix: ' games matched your criteria',
  });
})();
</script>
</body>
</html>
